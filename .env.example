# JONTRIX environment — copy to .env (local) or paste into your host's
# dashboard (VPS systemd/docker or Vercel → Settings → Environment Variables).
# Every var below is read by real code (src/lib/*). No invented entries.
#
# Generation commands (run once, keep the output private):
#   AUTH_SECRET : openssl rand -base64 32
#   BOOST_SALT  : openssl rand -hex 16
#   TELS lookup : https://cloud.google.com/docs/authentication/api-keys

# ── 1. REQUIRED ──────────────────────────────────────────────────────────────
# Database (Prisma). Local dev uses SQLite; a public deploy on ephemeral
# hosts (Vercel) needs hosted Postgres (Neon/Supabase free tiers).
DATABASE_URL="file:./db/jontrix.db"

# Canonical public origin — used to build email links and OAuth callback URLs.
# Prevents host-header manipulation of reset/verify links. No trailing slash.
# Dev: http://localhost:3000   Prod: https://your-domain
APP_ORIGIN="http://localhost:3000"

# HMAC secret for access payloads + sessions. If unset, one is generated and
# persisted to db/auth-secret (0600, gitignored) — fine for a single VPS,
# wrong for ephemeral hosts (rotates on every deploy and signs everyone out).
AUTH_SECRET=""

# ── 2. REAL EMAIL (required for real mail delivery) ──────────────────────────
# Driver: SMTP (nodemailer). With these unset the mailer runs driver:'log' —
# codes/links print to the server log, delivery reports honest false.
# SMTP_HOST + SMTP_PORT present = smtp mode. secure=true or port 465 = TLS.
# Free options (see docs/ENV-SETUP.md): Gmail app-password, Brevo (300/day),
# Resend SMTP (100/day, 3000/mo).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="JONTRIX <no-reply@your-domain>"

# ── 3. OAUTH (optional feature flags — both providers fully implemented) ─────
# Redirect URIs to register, exactly:
#   Google: ${APP_ORIGIN}/api/auth/oauth/google/callback
#   GitHub: ${APP_ORIGIN}/api/auth/oauth/github/callback
# Unset = the provider honestly reports "not configured".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── 4. TELEGRAM BOT + MINIAPP (optional) ─────────────────────────────────────
# @BotFather /newbot issues the token. WEBHOOK_SECRET must be set for the
# webhook route to accept Telegram calls (it refuses without it).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
MINIAPP_URL="https://t.me/JONTRIX_bot/app"

# AdsGram reward ads (MiniApp only, per spec: 1 ad = +10 daily calls, cap 2).
NEXT_PUBLIC_ADSGRAM_ID=""
# Optional server-side ad verification; unset = client claim trusted + logged.
ADSGRAM_VERIFY_KEY=""
# Salt for claim hashing — set a random value in production.
BOOST_SALT=""

# ── 5. RUNTIME ───────────────────────────────────────────────────────────────
# production flips Secure cookies, disables verbose dev paths.
NODE_ENV="development"
