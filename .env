# JONTRIX environment — maintained by `npm run setup` (idempotent).
# Reference: .env.example (full docs) and docs/ENV-SETUP.md.
# Hand-made additions are preserved below the KNOWN-KEYS marker.


# 1. REQUIRED — database + origin + signing
# sqlite; setup pins it absolute so CLI and runtime share one file
DATABASE_URL="file:/home/z/my-project/db/jontrix.db"
# canonical public origin, no trailing slash (email links + OAuth callbacks)
APP_ORIGIN="https://potential-system-jjqpp97pj7jr2p7gx-3000.app.github.dev"
# HMAC secret for sessions/tokens; generated once, kept across re-runs
AUTH_SECRET="j499whPYOTodUx+V3CRmD40oDlnT4Zu6/CGNSxl1q3o="

# 2. EMAIL — real delivery needs host+user+pass; otherwise the mailer logs codes
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="fraziymtech@gmail.com"
SMTP_PASS="jsrjlbcqqowaxips"
SMTP_FROM="JONTRIX <fraziymtech@gmail.com>"

# 3. OAUTH — optional; register the callback URLs printed at the end
GOOGLE_CLIENT_ID="673008022215-kcolbrvg5vsbdp4hak1348o95jdcpd76.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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"
